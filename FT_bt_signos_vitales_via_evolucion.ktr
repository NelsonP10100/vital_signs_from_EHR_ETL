    <rowlimit>0</rowlimit>
    <sql>--BUSCO LA FECHA MAXIMA CON LA QUE SE INSERTARON DATOS 
--CORRECTAMENTE EN STAGING PARA OBTENER DATOS A PARTIR DE ESE PUNTO

SELECT 
  MAX(fecha_ultima_modif) AS fecha_ultima_modif 
FROM 
  TABLA_CONTROL 
WHERE 
  UPPER(TRIM(nombre_transformacion)) = UPPER(TRIM(?)) --se hace insensible a mayusculas y espacios
  AND id_estado = 2

</sql>
