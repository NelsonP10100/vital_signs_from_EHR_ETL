  <step>
    <name>FT bt_signos_vitales_via_evolucion</name>
    <type>DBJoin</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>agise_staging</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT
    e.id_bt_consulta,
	e.sk_id_evolucion,
    e.id_evolucion,
    e.evolucion,
    c.id_consulta,
    c.hora_consulta,
    c.sk_id_paciente,
    c.id_paciente,
    c.edad_anios
FROM bt_evoluciones e
JOIN bt_consultas c
  ON c.id_bt_consulta = e.id_bt_consulta

WHERE 

 REGEXP_LIKE(e.evolucion, '[0-9]')

 AND e.fecha_hora_registro >= ?
 AND e.fecha_hora_registro &lt;  ?

  








--Para regeneraciones manuales:

  --e.fecha_hora_registro >= TO_DATE('2025-12-01 00:00:00', 'YYYY-MM-DD HH24:MI:SS')
  --AND e.fecha_hora_registro &lt;  TO_DATE('2026-02-6 00:00:00', 'YYYY-MM-DD HH24:MI:SS')

  --AND e.fecha_hora_registro >= ADD_MONTHS(?, -120) -- PARA CORRIDAS MANUALES
  --AND e.fecha_hora_registro &lt;  ?</sql>
    <outer_join>N</outer_join>
    <replace_vars>Y</replace_vars>
    <parameter>
      <field>
        <name>FECHA_ULTIMA_MODIF</name>
        <type>Timestamp</type>
      </field>
      <field>
        <name>FECHA_HORA_MAX_PIVOTEO</name>
        <type>Timestamp</type>
      </field>
    </parameter>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>1136</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
