  <step>
    <name>Buscar path archivo</name>
    <type>DBJoin</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>agise_staging</connection>
    <rowlimit>1</rowlimit>
    <sql>--OBTENGO EL PATH Y NOMBRE DE ARCHIVO DEL .CSV 
--GENERADO CORRECTAMENTE EN EL LOTE ACTUAL

SELECT 
  PATH as complete_path,
  NOMBRE_ARCHIVO
FROM 
  tabla_control 
WHERE 
  id_estado = 2 

  AND id_lote = ?

  AND UPPER(TRIM(nombre_transformacion)) = UPPER(TRIM(?)) --Se hace insensible a mayusculas y espacios

ORDER BY ID_CONTROL DESC --Si se estan haciendo pruebas, aseguro que agarro el ultimo archivo generado en este lote. 
						 --No afecta comportamiento en entorno productivo
  

</sql>
    <outer_join>N</outer_join>
    <replace_vars>Y</replace_vars>
    <parameter>
      <field>
        <name>ID_LOTE_A_EJECUTAR</name>
        <type>Integer</type>
      </field>
      <field>
        <name>nombre_transformacion_FT</name>
        <type>String</type>
      </field>
    </parameter>
